@model RankingPageViewModel
@{
    ViewData["Title"] = "Класации";
    Layout = "_DemoLayout";
    var q = Model.Query;
    string QuarterLabel(string p) => p.Length == 6 ? $"Q{p[5]} {p[..4]}" : p;
}

<h1>Класации по области</h1>
<p class="lead">Изберете вид класация. Стойностите, означени като „ДЕМО“, са измислени за илюстрация.</p>

<section class="panel" aria-labelledby="ft">
    <h2 id="ft">Филтър</h2>
    <form method="get" asp-controller="Ranking" asp-action="Index" class="controls">
        <div class="wide">
            <label for="kind">Вид класация</label>
            <select id="kind" name="kind">
                <option value="Employment" selected="@(q.Kind == RankingKind.Employment)">Заетост (НСИ)</option>
                <option value="Unemployment" selected="@(q.Kind == RankingKind.Unemployment)">Регистрирана безработица (АЗ)</option>
                <option value="Profession" selected="@(q.Kind == RankingKind.Profession)">Дял по професия (ДЕМО)</option>
            </select>
        </div>
        <div data-ranking-kinds="Employment">
            <label for="indicator">Показател (заетост)</label>
            <select id="indicator" name="indicator">
                <option value="EmpRate15to64" selected="@(q.Indicator == Indicator.EmpRate15to64)">Заетост 15–64 г.</option>
                <option value="EmpRate15Plus" selected="@(q.Indicator == Indicator.EmpRate15Plus)">Заетост 15+ г.</option>
                <option value="EmployedThousands" selected="@(q.Indicator == Indicator.EmployedThousands)">Заети, хил.</option>
            </select>
        </div>
        <div data-ranking-kinds="Employment">
            <label for="sex">Пол</label>
            <select id="sex" name="sex">
                <option value="Total" selected="@(q.Sex == Sex.Total)">Общо</option>
                <option value="Men" selected="@(q.Sex == Sex.Men)">Мъже</option>
                <option value="Women" selected="@(q.Sex == Sex.Women)">Жени</option>
            </select>
        </div>
        <div data-ranking-kinds="Employment Profession">
            <label for="period">Тримесечие на данните за заетост</label>
            <select id="period" name="period">
                @foreach (var p in Model.Periods)
                {
                    <option value="@p" selected="@(q.Period == p)">@QuarterLabel(p)</option>
                }
            </select>
        </div>
        <div class="wide" data-ranking-kinds="Profession">
            <label for="professionId">Професия (за ДЕМО класация)</label>
            <select id="professionId" name="professionId">
                @foreach (var p in Model.Professions)
                {
                    <option value="@p.Id" selected="@(q.ProfessionId == p.Id)">@p.Name</option>
                }
            </select>
        </div>
        <div>
            <label>&nbsp;</label>
            <button type="submit" class="btn-go">Покажи</button>
        </div>
    </form>
</section>

<section class="panel" aria-labelledby="rt">
    <h2 id="rt">Класация</h2>
    <div id="ranking">
        <partial name="_RankingTable" model="Model.Table" />
    </div>
</section>

@section Scripts {
    <script src="~/js/ranking-page.js" asp-append-version="true"></script>
}
