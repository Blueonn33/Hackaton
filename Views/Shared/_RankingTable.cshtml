@model Hackaton.Models.RankingViewModel
@using Hackaton.Models
@{
    var bg = new System.Globalization.CultureInfo("bg-BG");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string F(decimal v) => v.ToString("N" + Model.Decimals, bg);
    string Raw(decimal? v) => v?.ToString(inv) ?? "";
    var isProf = Model.Kind == RankingKind.Profession;
    var isUnemp = Model.Kind == RankingKind.Unemployment;
    var columnCount = isProf ? 5 : isUnemp ? 4 : 3;
}

<p class="sub">@Model.Subtitle</p>
<p class="hint">Натиснете заглавие на колона за сортиране или иконата до него за филтър по една колона.</p>

<div class="tablewrap">
    <table data-ranking data-default-sort="rank" aria-label="Класация по области">
        <thead>
            <tr>
                <th scope="col" class="num" data-column="rank" data-type="number">№</th>
                <th scope="col" data-column="name">Област</th>
                <th scope="col" data-column="value" data-type="number" data-direction="@(isUnemp ? "asc" : "desc")">@Model.ValueHeader</th>
                @if (isProf)
                {
                    <th scope="col" class="num" data-column="persons" data-type="number" data-direction="desc">≈ души (ДЕМО)</th>
                    <th scope="col" class="num" data-column="employed" data-type="number" data-direction="desc">Заети, хил. (НСИ)</th>
                }
                @if (isUnemp)
                {
                    <th scope="col" data-column="source" data-type="category">Източник</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                var cls = (r.IsDemo ? "demorow" : "") + (r.RegionName == Model.Selected ? " sel" : "");
                <tr class="@cls">
                    <td class="num" data-value="@r.Rank">@r.Rank</td>
                    <td>@r.RegionName</td>
                    <td data-value="@Raw(r.Value)">
                        <div class="cell">
                            <span class="num">@F(r.Value)@Model.Unit</span>
                            <span class="bar" aria-hidden="true"><i style="width:@((r.Value / Model.Max * 100).ToString("0.##", inv))%"></i></span>
                        </div>
                    </td>
                    @if (isProf)
                    {
                        <td class="num" data-value="@Raw(r.Persons)">@(r.Persons?.ToString("N0", bg) ?? "—")</td>
                        <td class="num" data-value="@Raw(r.EmployedThousands)">@(r.EmployedThousands?.ToString("N1", bg) ?? "—")</td>
                    }
                    @if (isUnemp)
                    {
                        <td data-value="@(r.IsDemo ? "ДЕМО" : "Реално (АЗ)")">
                            @if (r.IsDemo)
                            {
                                <span class="tag">ДЕМО</span>
                            }
                            else
                            {
                                <text>Реално (АЗ)</text>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="nat">
                <td></td>
                <td>@Model.NationalLabel</td>
                <td class="num">@F(Model.National)@Model.Unit</td>
                @if (columnCount > 3)
                {
                    <td colspan="@(columnCount - 3)"></td>
                }
            </tr>
        </tfoot>
    </table>
</div>

@if (!string.IsNullOrEmpty(Model.Note))
{
    <p class="note">@Model.Note</p>
}
